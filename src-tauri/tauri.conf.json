{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudCue",
  "version": "0.1.0",
  "identifier": "io.github.tigerrabbit.cloudcue",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CloudCue · CCSP practice",
        "width": 940,
        "height": 800,
        "minWidth": 360,
        "minHeight": 380
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../DISTRIBUTION-NOTICES.txt": "DISTRIBUTION-NOTICES.txt"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
